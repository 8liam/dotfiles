{
    "custom/launcher": {
        "format": "",
        "on-click": "fuzzel",
        "tooltip-format": "Application Launcher"
    },

    "custom/filemanager": {
        "format": "",
        "on-click": "thunar",
        "tooltip-format": "File Manager"
    },

    "custom/terminal": {
        "format": "",
        "on-click": "alacritty --working-directory ~/",
        "tooltip-format": "Terminal"
    },
    
    "hyprland/workspaces": {
        "all-outputs": true,
        "format": "",
        "on-scroll-up": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e+1\" })' 1>/dev/null",
        "on-scroll-down": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"e-1\" })' 1>/dev/null"
    },

    "hyprland/window": {
        "max-length": 160,
        "separate-outputs": true,
        "tooltip": false,
        "icon": true
    },

    "custom/perf-icon": {
        "format": "",
        "tooltip-format": "Performance"
    },

    "group/perf": {
        "orientation": "horizontal",
        "drawer": {
            "transition-duration": 400,
            "children-class": "perf-child",
            "transition-left-to-right": true
        },
        "modules": [
            "custom/perf-icon",
            "cpu",
            "temperature",
            "custom/gpu",
            "custom/gputemp",
            "memory"
        ]
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
        "format": "CPU {temperatureC}°C",
        "critical-threshold": 90,
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "RAM {percentage}%",
        "interval": 5,
        "tooltip-format": "{used:0.1f}GiB / {total:0.1f}GiB used"
    },

    "custom/gpu": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "GPU {}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gputemp": {
        "exec": "nvidia-smi --query-gpu=temperature.gpu --format=csv,noheader,nounits",
        "format": "GPU {}°C",
        "interval": 2,
        "tooltip": false
    },

    "mpris": {
        "format": "{player_icon} {artist} - {title} {status_icon}",
        "format-paused": "{player_icon} {artist} - {title} {status_icon}",
        "tooltip-format": "{artist} - {title} - {album} {length}",
        "player-icons": {
            "default": ""
        },
        "status-icons": {
            "playing": "",
            "paused": "",
            "stopped": ""
        },
        "on-click": "playerctl play-pause",
        "on-click-right": "playerctl stop"
    },

    "pulseaudio": {
        "scroll-step": 5, // %, can be a float
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "󰅶 {icon} {format_source}",
        "format-muted": "󰅶 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "󰂑",
            "headset": "󰂑",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "icon-size": 20,
        "spacing": 10
    },

    "battery": {
        "states": {
            // "good": 95,
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-full": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰃨",
        "format-plugged": "{capacity}% ",
        "format-alt": "{time} {icon}",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },

    "clock": {
        // "timezone": "America/New_York",
        "format": "{:%I:%M %p}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%A %B %Od %Y}"
    },

    "custom/power": {
        "format" : "",
		"tooltip-format": "Session Menu",
		"on-click": "wlogout"
    }
}