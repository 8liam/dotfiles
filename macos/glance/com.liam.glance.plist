<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.liam.glance</string>

    <!-- Apple `container` has no restart policy, so this brings Glance back at login.
         It must be a user LaunchAgent: the runtime is per-user, not a system service.
         Load once with:
           launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.liam.glance.plist -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec /bin/sh "$HOME/glance/glance.sh" up</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <!-- Retry if the container service isn't ready yet at login. -->
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/glance-launchagent.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/glance-launchagent.log</string>
</dict>
</plist>
